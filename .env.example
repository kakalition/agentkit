# --- Identity / app ---------------------------------------------------------
AGENT_NAME=assistant
OWNER_ID=owner
OWNER_NAME=Owner
# Agents live under the workspace root at <root>/<AGENT_NAME> by default.
AGENTKIT_HOME=~/.agentkit
# Optional explicit override (legacy name kept); blank uses AGENTKIT_HOME/AGENT_NAME.
AGENT_HOME=
LOG_LEVEL=INFO

# --- Model / provider -------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=openai:gpt-4o-mini
MODEL_TIMEOUT=60
MODEL_RETRIES=2
USAGE_REQUEST_LIMIT=
USAGE_TOTAL_TOKENS_LIMIT=

# --- Storage ----------------------------------------------------------------
# Blank uses a local file under AGENT_HOME.
DATABASE_URL=
LIBSQL_AUTH_TOKEN=

# --- Observability (on by default) ------------------------------------------
#   phoenix  - launch a local Arize Phoenix UI (default; needs the
#              'agentkit[observability-phoenix]' extra; falls back to console)
#   console  - print spans to the terminal (local, no account)
#   otlp     - export to a self-hosted OpenTelemetry backend (set OTLP_ENDPOINT)
#   off      - disable
OBSERVABILITY=phoenix
OTLP_ENDPOINT=
LOG_JSON=false

# --- Telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Skills (discoverable SKILL.md folders) ---------------------------------
SKILLS_ENABLED=true
# Override the default roots (./skills and <AGENT_HOME>/skills).
SKILLS_DIR=

# --- Prompts (file-backed prompt registry: prompts/<name>.md) ---------------
# Override the default roots (./prompts and <AGENT_HOME>/prompts).
PROMPTS_DIR=

# --- A2A --------------------------------------------------------------------
A2A_PUBLIC_URL=http://127.0.0.1:9000
A2A_CARD_NAME=Agent
A2A_HOST=127.0.0.1
A2A_PORT=9000
PEERS_FILE=

# --- MCP server -------------------------------------------------------------
MCP_HOST=127.0.0.1
MCP_PORT=8765

# --- Web UI (served by the agent process; loopback only) --------------------
WEBUI_ENABLED=true
WEBUI_HOST=127.0.0.1
WEBUI_PORT=8787
