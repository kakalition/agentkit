# --- Identity / app ---------------------------------------------------------
AGENT_NAME=assistant
OWNER_ID=owner
OWNER_NAME=Owner
AGENT_HOME=~/.local/share/agentkit
LOG_LEVEL=INFO

# --- Model / provider -------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=openai:gpt-4o-mini
MODEL_TIMEOUT=60
MODEL_RETRIES=2
USAGE_REQUEST_LIMIT=
USAGE_TOTAL_TOKENS_LIMIT=

# --- Storage ----------------------------------------------------------------
# Blank uses a local file under AGENT_HOME.
DATABASE_URL=
LIBSQL_AUTH_TOKEN=

# --- Observability ----------------------------------------------------------
OBSERVABILITY=off          # off | console | otlp | logfire
OTLP_ENDPOINT=
LOGFIRE_TOKEN=

# --- Telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# --- A2A --------------------------------------------------------------------
A2A_PUBLIC_URL=http://127.0.0.1:9000
A2A_CARD_NAME=Agent
A2A_HOST=127.0.0.1
A2A_PORT=9000
PEERS_FILE=

# --- MCP server -------------------------------------------------------------
MCP_HOST=127.0.0.1
MCP_PORT=8765
