// Global Kilo Code config — Command Code Provider API
// Docs: https://commandcode.ai/docs/provider
// Endpoints: https://api.commandcode.ai/provider/v1/chat/completions (OpenAI)
//            https://api.commandcode.ai/provider/v1/messages          (Anthropic)
// Auth: the API key is hardcoded below (same key the `cmd` CLI uses, from
//       https://commandcode.ai/settings/keys). This file is chmod 600 and lives
//       outside version control — keep it that way. Note the Kilo Settings UI
//       "Export" copies values as-is, so read kilo-settings.json before sharing.
//       Moving the key out later: swap it for "{env:CMD_API_KEY}" (works only in
//       this trusted global config, never in project config).
// Claude models are served ONLY on /v1/messages, everything else only on
// /chat/completions — hence the two provider entries below.
{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "commandcode/deepseek/deepseek-v4.1-flash",
  "permission": {
    "*": {},
    "bash": "allow",
  },
  "provider": {
    "commandcode": {
      "name": "Command Code",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.commandcode.ai/provider/v1",
        "apiKey": "user_3ww5HUVYpREYiuEv11vFKpJ9gJ4zMPpmvQLgCpS9Esf3f6w5Q5Hy3tsi9pphjEi5CBrqBWRm87WLra3XuJU4d8HT",
      },
